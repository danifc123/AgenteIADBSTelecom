# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env de verdade (já está no .gitignore).

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- IXC (obrigatório) ---
IXC_BASE_URL=https://demo.ixcsoft.com.br/webservice/v1
IXC_TOKEN=coloque_o_token_aqui
IXC_TIMEOUT_SECONDS=15

# --- Ollama ---
# Três cenários possíveis para OLLAMA_BASE_URL (ver README > "Ollama: host
# vs Docker" para a explicação completa e os números medidos):
#   1) Backend rodando direto no host (sem Docker):    http://localhost:11434
#   2) Backend em Docker, Ollama no host (RECOMENDADO,
#      mais rápido — é o padrão do docker-compose.yml): http://host.docker.internal:11434
#   3) Backend em Docker, Ollama TAMBÉM em Docker
#      (`docker compose --profile containerized-ollama up`): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# 180s dá folga pro "cold start" do modelo (primeira chamada após o
# container subir, ou após alguns minutos sem uso — o Ollama descarrega o
# modelo da memória depois de um tempo ocioso). Chamadas seguintes, com o
# modelo já carregado, respondem bem mais rápido que isso.
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_TOOL_ROUNDS=3
