# Copie para .env e ajuste o IP.
# IMPORTANTE: para testar em um dispositivo físico (celular real), use o IP
# da sua máquina na rede local (ex: 192.168.0.10), NUNCA "localhost" — o
# celular não consegue resolver "localhost" como sendo o computador que
# roda o backend.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
